# OpenTelemetry Observability Configuration
# Copy this file to .env.local and configure for your environment

# =============================================================================
# Server-Side OpenTelemetry Configuration
# =============================================================================

# OTLP endpoint for server-side telemetry export
# Default: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional: Bearer token for server-side authentication
# OTEL_EXPORTER_OTLP_BEARER_TOKEN=your-server-token-here

# =============================================================================
# Client-Side OpenTelemetry Configuration
# =============================================================================

# OTLP endpoint for client-side telemetry export
# Must be prefixed with NEXT_PUBLIC_ for client-side access
# Default: http://localhost:4318
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional: Bearer token for client-side authentication
# NEXT_PUBLIC_OTEL_EXPORTER_OTLP_BEARER_TOKEN=your-client-token-here

# =============================================================================
# Optional: OpenTelemetry SDK Configuration
# =============================================================================

# Set to 'true' to disable all OpenTelemetry instrumentation
# OTEL_SDK_DISABLED=false

# Set log level for OpenTelemetry SDK (debug, info, warn, error)
# OTEL_LOG_LEVEL=info

# =============================================================================
# Production Example (Observe Platform)
# =============================================================================

# For production deployment with Observe:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-observe-instance.observeinc.com:443
# OTEL_EXPORTER_OTLP_BEARER_TOKEN=your-observe-token
# NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=https://your-observe-instance.observeinc.com:443
# NEXT_PUBLIC_OTEL_EXPORTER_OTLP_BEARER_TOKEN=your-observe-token
